---
// Fußbereich: Verein, Kontaktwege, Rechtslinks.
//
// Die Kontaktwege stehen hier vollständig, nicht nur als Icon. Auf der alten
// Seite war der Kontakt ein Briefumschlag ohne Beschriftung, der zudem auf
// eine weiterleitende URL zeigte.

import type { SiteData } from '../../data/schema';

interface Props {
  site: SiteData;
  year?: number;
}

const { site, year = new Date().getFullYear() } = Astro.props;
const { contact, organizer, footer } = site;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-block">
      <p class="footer-heading">Kontakt</p>
      <ul class="footer-contact">
        <li>
          <a class="footer-link" href={`mailto:${contact.email}`}>
          {contact.email}</a>
        </li>
        <li>
          <a
            class="footer-link"
            href={contact.instagram.url}
            rel="me noopener noreferrer"
            target="_blank"
          >
            {contact.instagram.handle}
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-block">
      <p class="footer-heading">Veranstalter</p>
      <p class="footer-org">
        <a class="footer-link" href={organizer.url} rel="noopener noreferrer" target="_blank">
          {organizer.name}
        </a>
      </p>
      {footer.note && <p class="footer-note">{footer.note}</p>}
    </div>

    <div class="footer-block">
      <p class="footer-heading">Rechtliches</p>
      <ul class="footer-legal">
        {
          footer.links.map((link) => (
            <li>
              <a class="footer-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="footer-copy">© {year} {organizer.name}</p>
</footer>
