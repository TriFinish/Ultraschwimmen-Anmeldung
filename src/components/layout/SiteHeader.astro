---
// Kopfbereich: Logo als Weg zurück zur Startseite, daneben die Navigation.

import MainNav from './MainNav.astro';
import type { ResolvedNavItem } from '../../lib/nav';

interface Props {
  siteName: string;
  tagline: string;
  items: ResolvedNavItem[];
  /** Pfad zum Logo unter public/. */
  logo: string;
  /** Auf der Startseite ist das Logo kein Link — man ist schon da. */
  isHome?: boolean;
}

const { siteName, tagline, items, logo, isHome = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="brand">
      {
        isHome ? (
          <span class="brand-mark">
            <img src={logo} alt="" width="52" height="33" />
            <span class="brand-text">
              <span class="brand-name">{siteName}</span>
              <span class="brand-tagline">{tagline}</span>
            </span>
          </span>
        ) : (
          <a class="brand-mark" href="/">
            {/* alt leer, weil der Linktext direkt daneben dasselbe sagt —
                sonst liest ein Screenreader den Namen zweimal vor. */}
            <img src={logo} alt="" width="52" height="33" />
            <span class="brand-text">
              <span class="brand-name">{siteName}</span>
              <span class="brand-tagline">{tagline}</span>
            </span>
          </a>
        )
      }
    </div>

    <MainNav items={items} />
  </div>
</header>
