---
// Fließtext-Container.
//
// Stand vorher zehnmal als `<div class="prose">` in den Seiten, und die Regeln
// dazu global in site.css. Als Komponente ist die Textbreite an genau einer
// Stelle gepflegt — und wichtiger: Astro scopet diese Regeln, sodass die
// Element-Selektoren darin nicht mehr in fremdes Markup kaskadieren können.
// Genau davor warnt der Kommentarkopf von app.css.
//
// Die Kinder kommen aus Markdown (<Content />) oder aus der Seite selbst,
// deshalb `:global()` — sie tragen kein Scope-Attribut dieser Komponente.

interface Props {
  as?: 'div' | 'section';
}

const { as: Tag = 'div' } = Astro.props;
---

<Tag class="prose"><slot /></Tag>

<style>
  .prose {
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--ink);
  }

  .prose > :global(* + *) {
    margin-top: 1rem;
  }

  .prose :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.35rem;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 0.35rem;
  }

  .prose :global(a) {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose :global(strong) {
    font-weight: 700;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .prose :global(table) {
    width: 100%;
    margin: 0 0 1.5rem;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.55rem 0.6rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(thead th) {
    font-weight: 700;
    border-bottom-color: var(--line-strong);
  }

  .prose :global(hr) {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
</style>
