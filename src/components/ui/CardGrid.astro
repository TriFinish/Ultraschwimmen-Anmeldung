---
// Raster für Karten.
//
// Bewusst `auto-fit` statt fester Spaltenzahl je Breakpoint: Die Karten
// brechen dann von selbst um, egal ob drei Wettkampf-Kacheln oder neun
// Fotojahrgänge darin stehen.

interface Props {
  /** Mindestbreite einer Karte, bevor umgebrochen wird. */
  min?: string;
}

const { min = '15rem' } = Astro.props;
---

<div class="card-grid" style={`--card-min: ${min}`}><slot /></div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--card-min), 100%), 1fr));
    gap: 0.85rem;
  }
</style>
