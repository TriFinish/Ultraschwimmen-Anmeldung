---
// Die Handlungsaufforderung, die mitläuft.
//
// Auf dem Handy schwebt sie über der Daumenleiste — deshalb `--dock`, das die
// Höhe der Leiste kennt, statt einer geratenen Zahl. Auf breiten Geräten steht
// sie im Fluss: Dort ist die ganze Seite ohnehin im Blick, und eine mitlaufende
// Leiste wäre nur im Weg.
//
// Sie startet `hidden`. Sichtbar wird sie erst, wenn die Seite weiß, dass es
// etwas zu tun gibt — siehe src/scripts/page.ts.

interface Props {
  id?: string;
  href: string;
  label: string;
  /** ID des Links selbst — ein Skript aktualisiert sein Ziel je nach Auswahl. */
  linkId?: string;
  /** ID der Hinweiszeile, damit ein Skript sie aktualisieren kann. */
  hintId?: string;
  hidden?: boolean;
}

const { id, href, label, linkId, hintId, hidden = false } = Astro.props;
---

<div class="cta-bar" id={id} hidden={hidden}>
  <div class="cta-inner">
    <a class="cta" id={linkId} href={href} data-cta>
      <span>{label}</span>
      <span aria-hidden="true">→</span>
    </a>
    <p class="cta-hint" id={hintId}><slot /></p>
  </div>
</div>

<style>
  .cta-bar {
    position: fixed;
    z-index: 20;
    right: 0.75rem;
    bottom: calc(var(--dock) + 0.75rem);
    left: 0.75rem;

    padding: 0.75rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 1.25rem;
    /* Dieselbe Glasoptik wie die Daumenleiste darunter: Beide gehören zur
       schwebenden Ebene, nicht zum Seiteninhalt. */
    background: rgb(255 255 255 / 82%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      0 8px 32px rgb(11 31 51 / 16%),
      0 1px 0 rgb(255 255 255 / 60%) inset;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .cta-bar {
      background: var(--surface);
      border-color: var(--line);
    }
  }

  .cta-bar[hidden] {
    display: none;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: stretch;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    background: var(--accent-deep);
    color: #fff;
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--ink);
  }

  .cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cta-hint {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-align: center;
  }

  /* Ab Tablet im Fluss statt schwebend. */
  @media (min-width: 48rem) {
    .cta-bar {
      position: static;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
    }

    .cta-inner {
      align-items: flex-start;
    }

    .cta-hint {
      text-align: left;
    }
  }
</style>
