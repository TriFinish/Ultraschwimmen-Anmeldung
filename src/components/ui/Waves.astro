---
// Wellen.
//
// Übernommen von links.ultraschwimmen.de (Ultraschwimmen-Info-Site,
// site/index.html und site/assets/style.css). Dort tragen sie den ganzen
// visuellen Charakter der Seite; der Blauton ist derselbe wie `--accent` hier,
// die Übernahme deshalb nahtlos.
//
// Ein Unterschied zum Original: Dort liegen die Wellen `position: fixed` am
// unteren Bildschirmrand — das funktioniert nur auf einer Seite, die auf einen
// Bildschirm passt. Hier laufen sie im Fluss.
//
// Vier Ebenen mit unterschiedlicher Geschwindigkeit und Deckkraft ergeben die
// Tiefe. `prefers-reduced-motion` hält sie an: Eine Dauerbewegung am Seitenrand
// ist für manche Menschen nicht Dekoration, sondern Übelkeit.

interface Props {
  /** Höhe der Wellenfläche. */
  height?: string;
  /**
   * In welche Richtung die Fläche ausläuft. Ohne Ausblendung endet sie als
   * harte Kante und wirkt wie ein blauer Kasten statt wie Wasser.
   * `up` für den Übergang in den Fußbereich, `down` für einen Trenner.
   */
  fade?: 'up' | 'down' | 'both' | 'none';
  /**
   * Über die volle Fensterbreite laufen, auch innerhalb eines Containers.
   * Wellen mit sichtbarem linken und rechten Rand sehen aus wie ein Bild,
   * nicht wie Wasser.
   */
  bleed?: boolean;
  /**
   * Die Wellen sind die Wasseroberfläche, nicht nur ein Muster: Die unterste
   * Ebene wird deckend und trägt die Wasserfarbe. Darunter kann ein Bereich
   * mit derselben Farbe direkt anschließen — die Naht ist dann keine, weil
   * beide Seiten denselben Token benutzen.
   */
  surface?: boolean;
}

const { height = '9rem', fade = 'up', bleed = false, surface = false } = Astro.props;

// Die vier Ebenen sind derselbe Pfad, nur versetzt. Das Original arbeitet mit
// <defs><path id> und viermal <use href="#id"> — hier steht der Pfad
// stattdessen viermal ausgeschrieben. Grund: Die Wellen erscheinen mehrfach
// pro Seite (Fußbereich, jede Foto-Karte), und doppelte SVG-IDs machen
// `href="#…"` mehrdeutig. Eine generierte ID wiederum wäre bei jedem Build
// anders und machte den Diff von dist/ unlesbar. Vier kurze Pfade sind
// billiger als beide Probleme.
const PFAD = 'M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z';
const EBENEN = [0, 3, 5, 7];
---

<div
  class:list={[
    'waves',
    fade !== 'none' && `fade-${fade}`,
    bleed && 'is-bleeding',
    surface && 'is-surface',
  ]}
  style={`--waves-height: ${height}`}
  aria-hidden="true"
>
  <svg class="waves-svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
    <g class="wave-parallax">
      {
        /* Der Versatz sitzt auf der <g>-Hülle, die Bewegung auf dem Pfad
           darin. Beides auf demselben Element ginge nicht: Die CSS-Animation
           setzt `transform` und überschriebe damit den Versatz. */
        EBENEN.map((y) => (
          <g transform={`translate(48 ${y})`}>
            <path d={PFAD} />
          </g>
        ))
      }
    </g>
  </svg>
</div>

<style>
  .waves {
    width: 100%;
    height: var(--waves-height);
    pointer-events: none;
  }

  /* Nach oben auslaufend.
     
     Bewusst über viele Stützstellen statt mit zwei: Ein einzelner Farbstopp
     ergibt einen linearen Verlauf mit sichtbarem Knick dort, wo er beginnt —
     das Auge liest ihn als waagerechte Kante quer durch die Wellen. Die Kurve
     hier steigt unten flach an und wird nach oben schneller, wie eine
     Ausblendung eben aussieht.

     Unten bleiben die ersten 10 % voll deckend: Dort übergibt die unterste
     Wellenebene ihre Farbe an den Bereich darunter, und die muss exakt sein. */
  .waves.fade-up {
    --waves-mask: linear-gradient(
      to top,
      #000 0 10%,
      rgb(0 0 0 / 94%) 22%,
      rgb(0 0 0 / 82%) 34%,
      rgb(0 0 0 / 64%) 48%,
      rgb(0 0 0 / 42%) 63%,
      rgb(0 0 0 / 22%) 78%,
      rgb(0 0 0 / 8%) 90%,
      transparent 100%
    );
    -webkit-mask-image: var(--waves-mask);
    mask-image: var(--waves-mask);
  }

  .waves.fade-down {
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent);
    mask-image: linear-gradient(to bottom, #000 25%, transparent);
  }

  /* Nach oben UND unten auslaufend. Für die Wasserlinie über dem Fußbereich:
     Die Wellenkörper sind halbdurchsichtig und hellen den Verlauf darunter
     auf — hörten sie am Rand des Blocks abrupt auf, entstünde genau dort eine
     waagerechte Kante quer über die Seite. */
  .waves.fade-both {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 45%, transparent);
  }

  /* Aus dem Container ausbrechen: Die Fläche wird so breit wie das Fenster,
     unabhängig davon, wie schmal der Text darüber gesetzt ist. */
  .waves.is-bleeding {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .waves-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wave-parallax > g > path {
    animation: wave-move 25s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
  }

  .wave-parallax > g:nth-child(1) > path {
    animation-delay: -2s;
    animation-duration: 8s;
    fill: rgb(27 150 227 / 9%);
  }

  .wave-parallax > g:nth-child(2) > path {
    animation-delay: -3s;
    animation-duration: 11s;
    fill: rgb(27 150 227 / 13%);
  }

  .wave-parallax > g:nth-child(3) > path {
    animation-delay: -4s;
    animation-duration: 15s;
    fill: rgb(27 150 227 / 10%);
  }

  .wave-parallax > g:nth-child(4) > path {
    animation-delay: -5s;
    animation-duration: 21s;
    fill: rgb(27 150 227 / 22%);
  }

  /* --- Als Wasseroberfläche --------------------------------------------- */

  /* Ein schmales deckendes Band am unteren Rand, hinter dem SVG.
     
     Warum: Die unterste Wellenebene ist zwar deckend, endet aber exakt an der
     SVG-Kante. Landet die auf keiner ganzen Gerätepixel-Grenze — was von der
     Scrollposition abhängt und deshalb beim Scrollen kommt und geht —, scheint
     dort der helle Seitenhintergrund als Haarlinie durch. Das Band füllt genau
     diesen Spalt. Sichtbar ist es nie: Der tiefste Punkt der untersten
     Wellenebene liegt bei 96 % der Blockhöhe, das Band beginnt erst darunter. */
  .waves.is-surface {
    background: linear-gradient(to top, var(--water-line) 4px, transparent 4px);
  }

  /* Die vier Ebenen werden zur Tiefenstaffelung: oben ein Hauch Farbe auf dem
     hellen Grund, unten das volle Wasser. Die letzte Ebene ist deckend und
     füllt bis zum unteren Rand des Blocks durch — was darunter kommt, muss
     nur dieselbe Farbe tragen, und es gibt keinen Übergang zu treffen. */
  .waves.is-surface > .waves-svg .wave-parallax > g:nth-child(1) > path {
    fill: rgb(27 150 227 / 16%);
  }

  .waves.is-surface > .waves-svg .wave-parallax > g:nth-child(2) > path {
    fill: rgb(27 150 227 / 30%);
  }

  .waves.is-surface > .waves-svg .wave-parallax > g:nth-child(3) > path {
    fill: rgb(36 96 138 / 55%);
  }

  .waves.is-surface > .waves-svg .wave-parallax > g:nth-child(4) > path {
    fill: var(--water-line);
  }

  @keyframes wave-move {
    from {
      transform: translate3d(-90px, 0, 0);
    }
    to {
      transform: translate3d(85px, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-parallax > g > path {
      animation: none;
    }
  }
</style>
