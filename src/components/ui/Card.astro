---
// Die Grundform jeder Karte auf dieser Seite.
//
// Eine Karte ist entweder ein Link oder ein Behälter — beides zugleich gibt es
// nicht, weil verschachtelte Links weder für die Tastatur noch für
// Screenreader funktionieren. Ist `href` gesetzt, wird die ganze Karte zum
// Link; sonst kommt ein <article> heraus, und die Kinder verlinken selbst.
//
// Hover, Fokus und Glasoptik stehen genau hier. PostCard, PhotoAlbumCard und
// die Kacheln der Startseite erben sie, statt sie dreimal zu wiederholen.

const { href, external = false, hero = false, umamiEvent, as = 'article' } = Astro.props;

const Tag = href ? 'a' : as;
const linkAttrs = href
  ? {
      href,
      ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
      ...(umamiEvent ? { 'data-umami-event': umamiEvent } : {}),
    }
  : {};
---

<Tag
  class:list={['card', hero && 'is-hero', href && 'is-link', as === 'label' && 'is-choice']}
  {...linkAttrs}
>
  {Astro.slots.has('eyebrow') && <p class="card-eyebrow"><slot name="eyebrow" /></p>}
  {Astro.slots.has('media') && <div class="card-media"><slot name="media" /></div>}
  <div class="card-body"><slot /></div>
  {Astro.slots.has('footer') && <div class="card-footer"><slot name="footer" /></div>}
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    /* Ein Hauch Tiefe, kein Schlagschatten: Die Seite soll nach Wasser
       aussehen, nicht nach Material Design. */
    box-shadow: 0 1px 2px rgb(11 31 51 / 4%);
  }

  .card.is-link {
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .card.is-link:hover {
    border-color: var(--accent);
    box-shadow: 0 6px 18px rgb(27 150 227 / 14%);
    transform: translateY(-1px);
  }

  .card.is-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card.is-hero {
    border-color: var(--accent);
    background: linear-gradient(180deg, var(--accent-wash), var(--surface) 70%);
  }

  /* --- Auswahlkarte ------------------------------------------------------ */

  .card.is-choice {
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card.is-choice:hover {
    border-color: var(--line-strong);
  }

  /* Die Markierung hängt am echten Zustand des Feldes, nicht an einer Klasse,
     die ein Skript setzt: So stimmt sie auch ohne JavaScript. */
  .card.is-choice:has(:checked) {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
  }

  /* Der Fokusring gehört sichtbar an die Karte, nicht an das versteckte
     Feld — sonst sieht man beim Tabben nicht, wo man ist. */
  .card.is-choice:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card.is-choice {
      transition: none;
    }
  }

  .card-eyebrow {
    margin: 0;
    color: var(--accent-deep);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-media {
    margin: -1.15rem -1.25rem 0.35rem;
    overflow: hidden;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--accent-deep);
    font-size: var(--step--1);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .card.is-link,
    .card.is-link:hover {
      transform: none;
      transition: none;
    }
  }
</style>
