---
// Liste aus einzeiligen Zielen: Jahr → Ergebnisliste, Label → Seite.
//
// Wird von /ergebnisse/, /404/ und /fotos/ benutzt. Vorher stand dieselbe
// `<ul class="year-list">` in jeder dieser Seiten neu.
//
// Nimmt die Einträge als Daten und nicht als Slot: Alle drei Verwendungen
// haben dieselbe Form (Marke, Beschriftung, Ziel), und als Datenliste lässt
// sich zusichern, dass jedes externe Ziel sein `rel` bekommt.

export interface Tile {
  /** Große Marke links, z. B. das Jahr. Fehlt sie, rückt das Label nach vorn. */
  mark?: string | number;
  label: string;
  href: string;
  external?: boolean;
  umamiEvent?: string;
}

interface Props {
  items: Tile[];
  /** Vorlesbare Beschriftung, wenn die Liste keine Überschrift über sich hat. */
  label?: string;
}

const { items, label } = Astro.props;
---

<ul class="tiles" aria-label={label}>
  {
    items.map((item) => (
      <li class="tile">
        <a
          class="tile-link"
          href={item.href}
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          {...(item.umamiEvent ? { 'data-umami-event': item.umamiEvent } : {})}
        >
          {item.mark !== undefined && <span class="tile-mark">{item.mark}</span>}
          <span class="tile-label">{item.label}</span>
          <span class="tile-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .tile-link {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .tile-link:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .tile-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tile-mark {
    min-width: 3.5rem;
    font-size: var(--step-1);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tile-label {
    flex: 1;
    color: var(--ink-soft);
  }

  .tile-arrow {
    color: var(--accent-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-link {
      transition: none;
    }
  }
</style>
