---
// Häufige Fragen als aufklappbare Liste.
//
// Native <details>: Tastaturbedienung, aria-expanded und das Auf- und
// Zuklappen bringt der Browser mit — dieselbe Entscheidung wie bei der
// Navigation. Und ohne JavaScript sind die Antworten trotzdem erreichbar.

export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary class="faq-q">
          <span>{item.q}</span>
          <span class="faq-zeichen" aria-hidden="true" />
        </summary>
        <p class="faq-a">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Plus, das beim Aufklappen zum Minus wird — als Form, nicht als Zeichen:
     Ein „+" im Text läse ein Screenreader mit vor. */
  .faq-zeichen {
    position: relative;
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
  }

  .faq-zeichen::before,
  .faq-zeichen::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    border-radius: 1px;
    background: var(--accent-deep);
    transition: transform 0.2s ease;
  }

  .faq-zeichen::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-zeichen::after {
    transform: rotate(0deg);
  }

  .faq-a {
    margin: 0 0 1rem;
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-zeichen::before,
    .faq-zeichen::after {
      transition: none;
    }
  }
</style>
