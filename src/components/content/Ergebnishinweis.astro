---
// Hinweis auf die Ergebnisse, nachdem der Wettkampf gelaufen ist.
//
// Steht als `hidden` im HTML und wird per Skript eingeblendet. Zwei Gründe:
// Das ausgelieferte HTML bleibt für alle identisch (und damit cachebar), und
// der Hinweis blitzt nie kurz auf, bevor die Entscheidung fällt.
//
// Bewusst kein <dialog>: Ein modales Fenster sperrt die Seite und fängt den
// Fokus. Wer gerade den Zeitplan liest, soll weiterlesen können — der Hinweis
// ist ein Angebot, keine Frage.

interface Props {
  /** Wettkampftag aus event.yaml, Form „2026-08-29". */
  eventDate: string;
  jahr: number;
}

const { eventDate, jahr } = Astro.props;
---

<aside
  class="hinweis"
  id="ergebnishinweis"
  data-event-date={eventDate}
  aria-labelledby="ergebnishinweis-titel"
  hidden
>
  <p class="hinweis-titel" id="ergebnishinweis-titel">Ultraschwimmen {jahr} ist gelaufen</p>
  <p class="hinweis-text">Alle Zeiten, Platzierungen und Urkunden stehen bereit.</p>

  <div class="hinweis-aktionen">
    <a class="hinweis-link" href="/ergebnisse/" data-umami-event="Ergebnishinweis geöffnet">
      Zu den Ergebnissen →
    </a>
    <button class="hinweis-schliessen" type="button" data-schliessen>Nicht mehr anzeigen</button>
  </div>
</aside>

<style>
  .hinweis {
    position: fixed;
    z-index: 25;
    right: 0.75rem;
    /* Auf dem Handy oberhalb der Daumenleiste, sonst deckt sie ihn zur Hälfte. */
    bottom: calc(var(--dock) + 0.75rem);
    left: 0.75rem;

    max-width: 24rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 96%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 12px 32px rgb(11 31 51 / 18%);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hinweis {
      background: var(--surface);
      border-color: var(--line);
    }
  }

  @media (min-width: 48rem) {
    .hinweis {
      left: auto;
    }
  }

  .hinweis-titel {
    margin: 0 0 0.15rem;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
  }

  .hinweis-text {
    margin: 0 0 0.75rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .hinweis-aktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .hinweis-link {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--accent-deep);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .hinweis-link:focus-visible,
  .hinweis-schliessen:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hinweis-schliessen {
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }
</style>
