---
// Ein Beitrag aus „Aktuelles" als Karte.
//
// Bekommt den Collection-Eintrag als Ganzes — kommt ein Feld dazu, ändert sich
// diese Signatur nicht (Regel 1).
//
// Die Überschriftenebene ist eine Prop: In der Übersicht sind die Beiträge h2,
// als „mehr aus Aktuelles" unter einem Beitrag wären sie h3.

import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import Figure from '../ui/Figure.astro';
import { formatGermanDate, isoDate, postPath } from '../../lib/dates';

interface Props {
  post: CollectionEntry<'aktuelles'>;
  level?: 2 | 3;
}

const { post, level = 2 } = Astro.props;
const { title, date, excerpt, image } = post.data;
const Heading = `h${level}` as 'h2' | 'h3';
---

<Card href={postPath(post.id)}>
  {image && <Figure image={image} slot="media" />}

  <time class="post-date" datetime={isoDate(date)} slot="eyebrow">
    {formatGermanDate(date)}
  </time>

  <Heading class="post-title">{title}</Heading>
  {excerpt && <p class="post-excerpt">{excerpt}</p>}

  <span slot="footer">Weiterlesen →</span>
</Card>

<style>
  .post-date {
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .post-excerpt {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
