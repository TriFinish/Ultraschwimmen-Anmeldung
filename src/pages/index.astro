---
// Startseite.
//
// Die alte Startseite bestand aus einem Bild mit eingebranntem Text
// („Ultraschwimmen 2026 | 29. August 2026") und drei Kacheln. Wer das Bild
// nicht laden konnte, sah kein Datum. Hier steht alles als Text und kommt aus
// event.yaml — Datum, Ort und Frist können damit nicht mehr veralten.
//
// Kein Countdown: Der lebt im Trichter unter /anmelden/, wo er zur
// Entscheidung beiträgt. Hier wäre er Zierrat und brächte JavaScript mit.

import Page from '../layouts/Page.astro';
import Card from '../components/ui/Card.astro';
import CardGrid from '../components/ui/CardGrid.astro';
import Section from '../components/ui/Section.astro';
import Waves from '../components/ui/Waves.astro';
import DistanceTable from '../components/content/DistanceTable.astro';
import { loadEvent, loadResults } from '../data/load';
import { groupByStart } from '../lib/schedule';

const { event, venue, course, distances } = loadEvent();
const { years } = loadResults();

// Die längste Distanz ist der „Ultra", um den es geht.
const hero = distances.reduce((a, b) => (b.laps > a.laps ? b : a));
const guenstigste = distances.reduce((a, b) => (b.price < a.price ? b : a));
const slots = groupByStart(distances);
const jahre = [...years].sort((a, b) => a.year - b.year);
const erstesJahr = jahre[0]?.year;
const letztesJahr = jahre.at(-1)?.year;
---

<Page
  title={`${event.title} — ${venue.name}`}
  description={`${event.title} am ${event.date_label} im ${venue.name}: ${distances.length} Strecken von ${guenstigste.label} bis ${hero.label}, elektronische Zeitmessung, Neopren freigestellt.`}
  wide
>
  <section class="hero">
    <p class="hero-eyebrow">{event.date_label}</p>
    <h1 class="hero-title">{event.title}</h1>
    <p class="hero-lead">
      {distances.length} Strecken von {guenstigste.label} bis {hero.label} — im {venue.name},
      {' '}{course.lap_length_m} m je Runde. Neopren freigestellt, Zeitmessung elektronisch.
    </p>

    <div class="hero-actions">
      <a class="button" href="/anmelden/" data-umami-event="Startseite: Zur Anmeldung">
        Zur Anmeldung
        <span aria-hidden="true">→</span>
      </a>
      <p class="hero-note">Voranmeldung bis {event.deadline_label}</p>
    </div>

    {/* Derselbe Wellenzug wie im Fußbereich, hier nach unten offen: Er trennt
        den Einstieg vom Rest, statt eine Linie zu ziehen. */}
    <Waves height="6rem" fade="down" bleed />
  </section>

  <Section title="Strecken und Startzeiten">
    <DistanceTable distances={distances} withPrice />
    <Fragment slot="note">
      {
        event.youth_label &&
          `Für Kinder und Jugendliche (${event.youth_label}) gelten ermäßigte Gebühren. `
      }Alle Bedingungen stehen in der <a href="/ausschreibung/">Ausschreibung</a>.
    </Fragment>
  </Section>

  <Section title="Der Wettkampftag">
    <CardGrid>
      <Card href="/zeitplan/">
        <span class="tile-title">Zeitplan</span>
        <span class="tile-text">
          Wettkampfbüro ab {event.office_opens} Uhr, erster Start um {slots[0]?.start} Uhr.
        </span>
        <span slot="footer">Ansehen →</span>
      </Card>

      <Card href="/strecke/">
        <span class="tile-title">Strecke</span>
        <span class="tile-text">
          {course.headline} — Ein- und Ausstieg am Hafenkai, {venue.street}.
        </span>
        <span slot="footer">Ansehen →</span>
      </Card>

      <Card href="/ergebnisse/">
        <span class="tile-title">Ergebnisse</span>
        <span class="tile-text">
          Listen und Urkunden aller Jahrgänge{
            erstesJahr && ` seit ${erstesJahr}, zuletzt ${letztesJahr}`
          }.
        </span>
        <span slot="footer">Ansehen →</span>
      </Card>
    </CardGrid>
  </Section>
</Page>

<style>
  .tile-title {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .tile-text {
    color: var(--ink-soft);
  }
</style>
