---
// Übersicht der Beiträge.

import Page from '../../layouts/Page.astro';
import PostList from '../../components/content/PostList.astro';
import { getCollection } from 'astro:content';

const beitraege = await getCollection('aktuelles');
---

<Page
  title="Aktuelles"
  description="Neuigkeiten rund um das Ultraschwimmen in Münster — Wettkampfgelände, Wassertemperatur, Partner und Ergebnisse."
  heading="Aktuelles"
  lead="Meldungen rund um den Wettkampf — von der Wassertemperatur bis zum Standortwechsel."
  wide
>
  <PostList posts={beitraege} />
</Page>
