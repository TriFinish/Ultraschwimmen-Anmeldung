---
// Einzelner Beitrag.

import type { GetStaticPaths } from 'astro';
import Page from '../../layouts/Page.astro';
import Figure from '../../components/ui/Figure.astro';
import Prose from '../../components/ui/Prose.astro';
import { getCollection, render } from 'astro:content';
import { formatGermanDate, isoDate } from '../../lib/dates';

export const getStaticPaths = (async () => {
  const beitraege = await getCollection('aktuelles');
  return beitraege.map((beitrag) => ({
    params: { slug: beitrag.id },
    props: { beitrag },
  }));
}) satisfies GetStaticPaths;

const { beitrag } = Astro.props;
const { Content } = await render(beitrag);
const { title, date, excerpt, image } = beitrag.data;
---

<Page
  title={title}
  description={excerpt ?? `${title} — Neuigkeit vom Ultraschwimmen in Münster.`}
  heading={title}
  eyebrow={formatGermanDate(date)}
>
  {/* Das sichtbare Datum steht schon im Seitenkopf; hier nur noch maschinenlesbar. */}
  <time class="is-visually-hidden" datetime={isoDate(date)}>{formatGermanDate(date)}</time>

  {image && <Figure image={image} eager />}

  <Prose>
    <Content />
  </Prose>

  <p class="back-link">
    <a href="/aktuelles/">← Alle Meldungen</a>
  </p>
</Page>
